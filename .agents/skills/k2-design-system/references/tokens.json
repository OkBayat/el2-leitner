{
  "color": {
    "eager-green": {
      "$value": "#58CC02",
      "$type": "color",
      "$description": "Success, progress, correct-answer, and large green accent."
    },
    "storybook-green": {
      "$value": "#D7FFB8",
      "$type": "color",
      "$description": "Soft green success highlight wash."
    },
    "spark-blue": {
      "$value": "#1CB0F6",
      "$type": "color",
      "$description": "Primary CTA, information, and interactive links."
    },
    "fresh-leaf": {
      "$value": "#A5ED6E",
      "$type": "color",
      "$description": "Supporting green accent for short emphasized content."
    },
    "night-ink": {
      "$value": "#000437",
      "$type": "color",
      "$description": "Deep violet accent and light-theme inverse surface."
    },
    "paper-white": {
      "$value": "#FFFFFF",
      "$type": "color",
      "$description": "Page canvas, surfaces, and text on strong fills."
    },
    "charcoal": {
      "$value": "#4B4B4B",
      "$type": "color",
      "$description": "Headings, primary body copy, and secondary-button labels."
    },
    "pencil-gray": {
      "$value": "#777777",
      "$type": "color",
      "$description": "Secondary descriptive text."
    },
    "faded-gray": {
      "$value": "#AFAFAF",
      "$type": "color",
      "$description": "Disabled content and routine borders."
    },
    "button-disabled-gray": {
      "$value": "#D9D9D9",
      "$type": "color",
      "$description": "Disabled button faces and disabled secondary labels."
    },
    "button-border-gray": {
      "$value": "#E5E5E5",
      "$type": "color",
      "$description": "Enabled and disabled secondary button borders."
    },
    "attention-yellow": {
      "$value": "#FFC800",
      "$type": "color",
      "$description": "Warning actions and attention states."
    },
    "answer-red": {
      "$value": "#FF4B4B",
      "$type": "color",
      "$description": "Incorrect-answer, error, and destructive semantics."
    },
    "mist": {
      "$value": "#F1F5F2",
      "$type": "color",
      "$description": "Neutral subtle surface for quiet separation."
    },
    "soft-border": {
      "$value": "#E4EAE6",
      "$type": "color",
      "$description": "Light-theme subtle border."
    },
    "purple-light": {
      "$value": "#A98BFF",
      "$type": "color",
      "$description": "Dark-theme secondary emphasis."
    }
  },
  "font": {
    "feather": {
      "$value": "feather",
      "$type": "fontFamily",
      "$description": "Display headlines at 48px or larger. Use Feather Bold or Nunito Black as a substitute."
    },
    "duolingo-sans": {
      "$value": "duolingo-sans",
      "$type": "fontFamily",
      "$description": "Body, controls, navigation, and subheadings. Use Inter or Nunito Sans as a substitute."
    }
  },
