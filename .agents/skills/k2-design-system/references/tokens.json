{
  "color": {
    "eager-green": {
      "$value": "#58CC02",
      "$type": "color",
      "$description": "Success, progress, correct-answer, and large green accent."
    },
    "storybook-green": {
      "$value": "#D7FFB8",
      "$type": "color",
      "$description": "Soft green highlight wash."
    },
    "spark-blue": {
      "$value": "#1CB0F6",
      "$type": "color",
      "$description": "Primary CTA and interactive links."
    },
    "fresh-leaf": {
      "$value": "#A5ED6E",
      "$type": "color",
      "$description": "Supporting green accent for short emphasized content."
    },
    "night-ink": {
      "$value": "#000437",
      "$type": "color",
      "$description": "Deep violet accent for emphasis."
    },
    "paper-white": {
      "$value": "#FFFFFF",
      "$type": "color",
      "$description": "Page canvas, surfaces, and text on strong fills."
    },
    "charcoal": {
      "$value": "#4B4B4B",
      "$type": "color",
      "$description": "Headings and primary body copy."
    },
    "pencil-gray": {
      "$value": "#777777",
      "$type": "color",
      "$description": "Secondary descriptive text."
    },
    "faded-gray": {
      "$value": "#AFAFAF",
      "$type": "color",
      "$description": "Disabled content and outlined-button borders."
    },
    "button-disabled-gray": {
      "$value": "#D9D9D9",
      "$type": "color",
      "$description": "Disabled button faces and disabled secondary labels."
    },
    "button-border-gray": {
      "$value": "#E5E5E5",
      "$type": "color",
      "$description": "Enabled and disabled secondary button borders."
    },
    "attention-yellow": {
      "$value": "#FFC800",
      "$type": "color",
      "$description": "Vocora extension for warning actions and attention states."
    },
    "answer-red": {
      "$value": "#FF4B4B",
      "$type": "color",
      "$description": "Vocora extension for incorrect-answer and destructive actions."
    }
  },
  "font": {
    "feather": {
      "$value": "feather",
      "$type": "fontFamily",
      "$description": "Display headlines at 48px or larger. Use Feather Bold or Nunito Black as a substitute."
    },
    "duolingo-sans": {
      "$value": "duolingo-sans",
      "$type": "fontFamily",
      "$description": "Body, controls, navigation, and subheadings. Use DIN Next, Inter, or Nunito Sans as a substitute."
    }
  },
  "themes": {
    "light": {
      "surface": {
        "page": "#FFFFFF",
        "base": "#FFFFFF",
        "raised": "#FFFFFF",
        "subtle": "#D7FFB8",
        "border": "#AFAFAF"
      },
      "text": {
        "primary": "#4B4B4B",
        "secondary": "#777777",
        "disabled": "#AFAFAF",
        "onStrong": "#FFFFFF"
      },
      "action": {
        "primary": "#1CB0F6",
        "primaryHover": "#1CB0F6",
        "primaryForeground": "#FFFFFF",
        "secondary": "#FFFFFF",
        "secondaryHover": "#FFFFFF",
        "secondaryForeground": "#4B4B4B",
        "secondaryBorder": "#E5E5E5",
        "secondaryDisabledBackground": "#FFFFFF",
        "secondaryDisabledForeground": "#D9D9D9",
        "secondaryDisabledBorder": "#E5E5E5",
        "success": "#58CC02",
        "successHover": "#58CC02",
        "successForeground": "#FFFFFF",
        "warning": "#FFC800",
        "warningHover": "#FFC800",
        "warningForeground": "#4B4B4B",
        "error": "#FF4B4B",
        "errorHover": "#FF4B4B",
        "errorForeground": "#FFFFFF",
        "disabledBackground": "#D9D9D9",
        "disabledForeground": "#777777",
        "disabledBorder": "#D9D9D9",
        "focusRing": "#1CB0F6"
      }
    },
    "dark": {
      "surface": {
        "page": "#0F1611",
        "base": "#161F19",
        "raised": "#1D2921",
        "subtle": "#223027",
        "border": "#536159"
      },
      "text": {
        "primary": "#F0F7F2",
        "secondary": "#A9B8AD",
        "disabled": "#6F7D73",
        "onStrong": "#F6FFF8"
      },
      "action": {
        "primary": "#49C0F8",
        "primaryHover": "#5CC8FA",
        "primaryForeground": "#063F5C",
        "secondary": "#FFFFFF",
        "secondaryHover": "#FFFFFF",
        "secondaryForeground": "#4B4B4B",
        "secondaryBorder": "#AFAFAF",
        "secondaryDisabledBackground": "#FFFFFF",
        "secondaryDisabledForeground": "#6F7D73",
        "secondaryDisabledBorder": "#AFAFAF",
        "success": "#72D72B",
        "successHover": "#83E640",
        "successForeground": "#0F2900",
        "warning": "#FFC45A",
        "warningHover": "#FFD178",
        "warningForeground": "#352100",
        "error": "#FF6B6B",
        "errorHover": "#FF8585",
        "errorForeground": "#4A0000",
        "disabledBackground": "#344239",
        "disabledForeground": "#829087",
        "disabledBorder": "#46564B",
        "focusRing": "#49C0F8"
      }
    }
  },
  "$extensions": {
    "com.vocora.design-system": {
      "defaultTheme": "light",
      "themes": ["light", "dark"],
      "baseUnit": "4px",
      "buttonRadius": "13px",
      "minimumTouchTarget": "44px"
    }
  }
}
