  "$extensions": {
    "com.vocora.design-system": {
      "defaultTheme": "light",
      "themes": ["light", "dark"],
      "runtimeSource": "ui/src/styles/_vocora-design-system.scss",
      "frameworkAdapters": [
        "ui/src/styles/_bootstrap-theme.scss",
        "ui/src/styles/_angular-material-theme.scss"
      ],
      "baseUnit": "4px",
      "buttonRadius": "13px",
      "minimumTouchTarget": "44px"
    }
