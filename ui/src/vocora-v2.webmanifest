{
  "id": "/",
  "name": "Vocora",
  "short_name": "Vocora",
  "description": "Daily IELTS vocabulary review with pronunciation, mistake rechecks, and a Leitner learning system.",
  "lang": "en",
  "dir": "ltr",
  "start_url": "/dashboard",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#48BF68",
  "theme_color": "#f8f9ff",
  "categories": ["education", "productivity"],
  "prefer_related_applications": false,
  "related_applications": [],
  "icons": [
    { "src": "/assets/icons/vocora-v2-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/assets/icons/vocora-v2-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/assets/icons/vocora-v2-maskable-192.png", "sizes": "192x192", "type": "image/png", "purpose": "maskable" },
    { "src": "/assets/icons/vocora-v2-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    {
      "name": "Start today's review",
      "short_name": "Review",
      "description": "Open the due vocabulary review session.",
      "url": "/review",
      "icons": [{ "src": "/assets/icons/vocora-v2-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Open word bank",
      "short_name": "Words",
      "description": "Search and manage your vocabulary.",
      "url": "/words",
      "icons": [{ "src": "/assets/icons/vocora-v2-192.png", "sizes": "192x192", "type": "image/png" }]
    }
  ]
}
