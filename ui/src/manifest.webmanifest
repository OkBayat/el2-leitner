{
  "id": "/",
  "name": "Vocora – IELTS Vocabulary Trainer",
  "short_name": "Vocora",
  "description": "Daily IELTS vocabulary review with pronunciation, mistake rechecks, and a Leitner learning system.",
  "lang": "en",
  "dir": "ltr",
  "start_url": "/dashboard",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#f8f9ff",
  "theme_color": "#1a73e8",
  "categories": ["education", "productivity"],
  "prefer_related_applications": false,
