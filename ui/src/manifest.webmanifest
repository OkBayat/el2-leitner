  ],
  "shortcuts": [
    {
      "name": "Start today's review",
      "short_name": "Review",
      "description": "Open the due vocabulary review session.",
      "url": "/review",
      "icons": [{ "src": "/assets/icons/icon-192.png", "sizes": "192x192", "type": "image/png" }]
