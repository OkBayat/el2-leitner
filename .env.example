# Application
NODE_ENV=development
PORT=3000
APP_PORT=3000
APP_HOST=0.0.0.0
JWT_SECRET=replace-with-a-long-random-secret-of-at-least-32-characters
JWT_EXPIRES_IN=7d
AUTH_COOKIE_NAME=leitner_session
AUTH_COOKIE_MAX_AGE_MS=604800000
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=10
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
TRUST_PROXY=false
# Exact credentialed browser/WebView origins for this environment. Never use *
# with cookie authentication. Use https://dev.vocora.ir for staging and
# https://vocora.ir for production, keeping native origins when those clients
# are enabled.
CORS_ALLOWED_ORIGINS=https://localhost,capacitor://localhost

# Configure all three values per platform only after the store listing exists.
# MOBILE_ANDROID_LATEST_VERSION=3.0.0
# MOBILE_ANDROID_MINIMUM_SUPPORTED_VERSION=3.0.0
# MOBILE_ANDROID_STORE_URL=https://play.google.com/store/apps/details?id=ir.vocora
# MOBILE_IOS_LATEST_VERSION=3.0.0
# MOBILE_IOS_MINIMUM_SUPPORTED_VERSION=3.0.0
# MOBILE_IOS_STORE_URL=https://apps.apple.com/app/id0000000000

# Compose configures the private speech service automatically.
# For a backend outside Compose, see docs/SHADOWING.md.
# SHADOWING_SPEECH_URL=http://127.0.0.1:8082

# Self-hosted Kokoro TTS. Compose keeps Kokoro private and configures its URL.
KOKORO_IMAGE_TAG=v0.8.2
KOKORO_API_LOG_LEVEL=INFO
KOKORO_TTS_MODEL=kokoro
TTS_ALLOWED_VOICES=af_bella,af_heart,af_sky,bf_emma
TTS_DEFAULT_VOICE=af_heart
TTS_DEFAULT_SPEED=1
TTS_DEFAULT_FORMAT=mp3
TTS_REQUEST_TIMEOUT_MS=120000
TTS_MAX_TEXT_LENGTH=5000
# Change this whenever the image/model or synthesis behavior changes intentionally.
TTS_MODEL_VERSION=kokoro-v1.0@kokoro-fastapi-v0.8.2
# For a backend outside Compose:
# KOKORO_TTS_URL=http://127.0.0.1:8880
# TTS_CACHE_DIRECTORY=/absolute/path/to/tts-cache

# Optional override for local BBC/listening MP3 files.
# Defaults to back/data/listening/audio.
# LISTENING_AUDIO_DIRECTORY=/absolute/path/to/listening/audio

# Comma-separated emails allowed to create/edit public library collections.
LIBRARY_ADMIN_EMAILS=admin@example.com

# MySQL application connection (least privilege)
DB_HOST=mysql
DB_PORT=3306
DB_NAME=leitner_ielts
DB_USER=leitner_app
DB_PASSWORD=replace-with-a-strong-app-password
DB_CONNECT_RETRIES=30
DB_CONNECT_RETRY_MS=2000
DB_CONNECTION_LIMIT=10

# Database setup connection (schema administration only).
# With Docker Compose this password must match MYSQL_ROOT_PASSWORD below.
DB_ADMIN_USER=root
DB_ADMIN_PASSWORD=replace-with-a-strong-root-password

# MySQL container bootstrap
MYSQL_ROOT_PASSWORD=replace-with-a-strong-root-password

# Host bindings for browser access from the local network.
# Use 127.0.0.1 instead when access should be limited to the server itself.
PHPMYADMIN_HOST=0.0.0.0
PHPMYADMIN_PORT=8081
