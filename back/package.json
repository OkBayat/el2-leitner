{
  "name": "vocora-api",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Express and MySQL backend for Vocora",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "db:setup": "node scripts/setup-database.js",
    "db:verify": "node scripts/verify-database.js && node scripts/verify-sentence-sources.js",
    "db:validate:listening": "node scripts/validate-listening-lessons.js",
    "db:seed:sentences": "node scripts/seed-sentence-practice.js",
    "db:validate:sentences": "node scripts/seed-sentence-practice.js --dry-run",
    "test": "npm run db:validate:listening && npm run db:validate:sentences && npm run test:episode-tools && node --test",
    "test:watch": "node --test --watch",
    "test:episode-tools": "python3 -m unittest discover -s tests/tooling -p 'test_*.py'"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "express-rate-limit": "^8.2.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.15.3"
  },
  "devDependencies": {
    "supertest": "^7.1.4"
  }
}
