NODE_ENV=development
PORT=3000

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=leitner_ielts
DB_USER=leitner_app
DB_PASSWORD=replace-with-a-strong-app-password
DB_ADMIN_USER=root
DB_ADMIN_PASSWORD=change-this-root-password
DB_CONNECTION_LIMIT=10
DB_CONNECT_RETRIES=30
DB_CONNECT_RETRY_MS=2000

# Use a long, random value in production (at least 32 characters).
JWT_SECRET=replace-this-with-a-long-random-secret
JWT_EXPIRES_IN=7d
AUTH_COOKIE_NAME=leitner_session
AUTH_COOKIE_MAX_AGE_MS=604800000
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=10
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
TRUST_PROXY=false
CORS_ALLOWED_ORIGINS=https://localhost,capacitor://localhost

# Optional store release policy; configure each platform as an all-or-nothing set.
# MOBILE_ANDROID_LATEST_VERSION=3.0.0
# MOBILE_ANDROID_MINIMUM_SUPPORTED_VERSION=3.0.0
# MOBILE_ANDROID_STORE_URL=https://play.google.com/store/apps/details?id=ir.vocora
# MOBILE_IOS_LATEST_VERSION=3.0.0
# MOBILE_IOS_MINIMUM_SUPPORTED_VERSION=3.0.0
# MOBILE_IOS_STORE_URL=https://apps.apple.com/app/id0000000000

# Comma-separated emails allowed to create/edit public library collections.
LIBRARY_ADMIN_EMAILS=admin@example.com

# Self-hosted Kokoro TTS (required for local backend execution outside Compose).
KOKORO_TTS_URL=http://127.0.0.1:8880
KOKORO_TTS_MODEL=kokoro
TTS_CACHE_DIRECTORY=./data/tts-cache
TTS_ALLOWED_VOICES=af_bella,af_heart,af_sky,bf_emma
TTS_DEFAULT_VOICE=af_heart
TTS_DEFAULT_SPEED=1
TTS_DEFAULT_FORMAT=mp3
TTS_REQUEST_TIMEOUT_MS=120000
TTS_MAX_TEXT_LENGTH=5000
TTS_MODEL_VERSION=kokoro-v1.0@kokoro-fastapi-v0.8.2
